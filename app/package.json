{
  "name": "gp5-tone-studio",
  "productName": "GP-5 Tone Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop editor and librarian for the Valeton GP-5",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:toolkit": "node --test src/renderer/src/gp5/tests/",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.52.0",
    "neural-amp-modeler-wasm": "^2.0.1",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "neural-amp-modeler-wasm": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "allowScripts": {
    "electron@43.7.9": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
